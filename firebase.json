{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": false,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "**",
        "run": { "serviceId": "shiftitnow-website", "region": "us-central1" }
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }]
      },
      {
        "source": "**/*.@(webp|svg|png|jpg|jpeg|gif|ico)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      }
    ]
  }
}
